  # undici (transitive via @apidevtools/json-schema-ref-parser@16.0.1, range ^8.10.0).
  # NOT currently fixable: a Sept 2026 advisory wave affects all published 8.10.x
  # releases and undici `latest` is 8.10.2 - there is NO patched version to upgrade
  # or override to yet. `npm update undici` does not help. Re-scan and remove these
  # once undici ships a fixed release and json-schema-ref-parser allows it.
  # Short expiry (2026-09-21) is deliberate so this is revisited weekly, not left to rot.
  SNYK-JS-UNDICI-19635206:
    - "*":
        reason: "undici 8.10.x unpatched upstream (Sept 2026 advisory wave); no fixed version published; temporary deploy unblock, revisit weekly"
        expires: "2026-09-21"
